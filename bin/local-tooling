#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from local_tooling.agent_config import (
    CODEX_MARKER_START,
    codex_block,
    configure_agents,
    mcp_json,
    parse_agents,
    patch_codex,
    patch_json_mcp,
)
from local_tooling.docker_runtime import (
    check_port,
    command_exists,
    compose_cmd,
    docker_compose_available,
    docker_daemon_running,
    health,
    start_stack,
    stop_stack,
    wait_for_health,
)
from local_tooling.env import load_env
from local_tooling.manifest import default_profile, generate_manifest, index_repo
from local_tooling.zendesk import (
    require_zendesk_config,
    zendesk_auth_headers,
    zendesk_config_errors,
    zendesk_enabled,
    zendesk_get,
    zendesk_index_query,
    zendesk_ingest_ticket,
    zendesk_search_tickets,
)
from local_tooling.workflow import (
    install_agent_rules,
    learn,
    prepare_context,
    review_change,
    session_dir,
    write_latest_session,
)

DEFAULT_CONTEXT_LIMIT = 8


def read_stdin_if_requested(value: str | None) -> str:
    if value == "-":
        return sys.stdin.read().strip()
    return value or ""


def doctor(env: dict[str, str]) -> None:
    compose_ok, compose_message = docker_compose_available()
    daemon_ok, daemon_message = docker_daemon_running()
    checks = {
        "docker": command_exists("docker"),
        "docker compose": compose_ok,
        "docker daemon": daemon_ok,
        "node": command_exists("node"),
        "npm": command_exists("npm"),
    }
    for name, ok in checks.items():
        print(f"{name}: {'ok' if ok else 'missing'}")
    if not all(checks.values()):
        if not compose_ok:
            print(f"Docker Compose detail: {compose_message}")
        if not daemon_ok:
            print("Docker daemon detail:")
            print(daemon_message)
            print("Start Docker Desktop or your Docker daemon, then retry.")
        raise SystemExit(1)

    vdb_port = int(env.get("VDB_API_PORT", "8000"))
    print(f"localhost:{vdb_port}: {'open' if check_port('127.0.0.1', vdb_port) else 'closed'}")
    payload = health(env)
    print(json.dumps(payload, indent=2))

    warnings: list[str] = []
    embedding_backend = env.get("EMBEDDING_BACKEND", "mock").lower()
    valid_embedding_backends = {"mock", "ollama", "openai-compatible"}
    if embedding_backend not in valid_embedding_backends:
        warnings.append(
            "Unsupported EMBEDDING_BACKEND="
            f"{embedding_backend}; expected one of: {', '.join(sorted(valid_embedding_backends))}"
        )
    if embedding_backend == "openai-compatible" and not env.get("EMBEDDING_API_KEY"):
        warnings.append("EMBEDDING_API_KEY is required for EMBEDDING_BACKEND=openai-compatible")
    if not env.get("GITHUB_PERSONAL_ACCESS_TOKEN"):
        warnings.append("GITHUB_PERSONAL_ACCESS_TOKEN is empty; GitHub MCP will not authenticate")
    if not zendesk_enabled(env):
        print("zendesk: disabled")
    else:
        print("zendesk: enabled")
        zendesk_errors = zendesk_config_errors(env)
        if zendesk_errors:
            warnings.extend(zendesk_errors)
        else:
            me = zendesk_get(env, "/api/v2/users/me.json")
            user = me.get("user") if isinstance(me, dict) else None
            user_id = user.get("id") if isinstance(user, dict) else None
            print(f"zendesk health: ok user_id={user_id}")
    if warnings:
        print("Warnings:")
        for warning in warnings:
            print(f"- {warning}")
        if zendesk_enabled(env) and zendesk_config_errors(env):
            raise SystemExit(1)


def print_config(agent: str, env: dict[str, str]) -> None:
    if agent == "codex":
        print(codex_block(env))
    elif agent in {"cursor", "claude"}:
        print(json.dumps({"mcpServers": mcp_json(env)}, indent=2, sort_keys=True))
    else:
        raise SystemExit(f"Unsupported agent: {agent}")


def exec_mcp(name: str, env: dict[str, str]) -> None:
    if name == "vectordb":
        cmd = compose_cmd("run", "--rm", "-T", "vectordb-mcp-bridge")
    elif name == "github":
        cmd = [
            "docker",
            "run",
            "-i",
            "--rm",
            "-e",
            "GITHUB_PERSONAL_ACCESS_TOKEN",
            "ghcr.io/github/github-mcp-server",
            "stdio",
            "--read-only",
        ]
    elif name == "atlassian":
        url = env.get("ATLASSIAN_MCP_URL", "https://mcp.atlassian.com/v1/mcp")
        site = env.get("ATLASSIAN_SITE_URL", "")
        cmd = ["npx", "-y", "mcp-remote@latest", url]
        if site:
            cmd.extend(["--transport", "http-first", "--resource", site])
    elif name == "kapa":
        url = env.get("KAPA_REMOTE_MCP_URL", "")
        if not url:
            raise SystemExit("KAPA_REMOTE_MCP_URL is required")
        header = env.get("KAPA_REMOTE_MCP_AUTH_HEADER", "")
        if not header and env.get("KAPA_API_TOKEN"):
            header = f"Authorization: Bearer {env['KAPA_API_TOKEN']}"
        cmd = ["npx", "-y", "mcp-remote", url]
        if header:
            cmd.extend(["--header", header])
    elif name == "zendesk":
        require_zendesk_config(env)
        cmd = compose_cmd("run", "--rm", "-T", "zendesk-mcp-adapter")
    else:
        raise SystemExit(f"Unknown MCP server: {name}")

    os.execvpe(cmd[0], cmd, env)


def setup(args: argparse.Namespace, env: dict[str, str]) -> None:
    repo = Path(args.repo).expanduser().resolve()
    profile = default_profile(repo, args.profile)

    if not args.skip_start:
        start_stack(env)
        wait_for_health(env)

    configure_agents(parse_agents(args.agents), env)
    manifest = generate_manifest(repo, profile)
    print(f"Generated manifest: {manifest}")

    if args.bootstrap:
        index_repo(repo, profile, env)
        if zendesk_enabled(env):
            query = env.get("ZENDESK_INDEX_DEFAULT_QUERY", "").strip()
            if not query:
                raise SystemExit("ZENDESK_INDEX_DEFAULT_QUERY is required when ZENDESK_ENABLED=true and --bootstrap is used")
            print(f"Indexing Zendesk tickets with query: {query}")
            result = zendesk_index_query(env, query)
            print(json.dumps(result, indent=2))
        else:
            print("Zendesk bootstrap skipped: ZENDESK_ENABLED=false")

    if not args.skip_doctor:
        doctor(env)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="local-tooling")
    sub = parser.add_subparsers(dest="command", required=True)

    setup_parser = sub.add_parser("setup")
    setup_parser.add_argument("--agents", default="codex", help="all, codex, cursor, claude, or comma-separated list")
    setup_parser.add_argument("--repo", required=True)
    setup_parser.add_argument("--profile", choices=["default", "gravitee-apim"])
    setup_parser.add_argument("--bootstrap", action="store_true")
    setup_parser.add_argument("--skip-start", action="store_true", help=argparse.SUPPRESS)
    setup_parser.add_argument("--skip-doctor", action="store_true", help=argparse.SUPPRESS)

    sub.add_parser("start")
    sub.add_parser("stop")
    sub.add_parser("doctor")

    manifest_parser = sub.add_parser("manifest")
    manifest_parser.add_argument("--repo", required=True)
    manifest_parser.add_argument("--profile", choices=["default", "gravitee-apim"])

    index_parser = sub.add_parser("index")
    index_parser.add_argument("--repo", required=True)
    index_parser.add_argument("--profile", choices=["default", "gravitee-apim"])

    context_parser = sub.add_parser("context")
    context_parser.add_argument("--repo", required=True)
    context_parser.add_argument("--task", required=True, help="Task text, or '-' to read from stdin")
    context_parser.add_argument("--limit", type=int, default=DEFAULT_CONTEXT_LIMIT)

    learn_parser = sub.add_parser("learn")
    learn_parser.add_argument("--repo", required=True)
    learn_parser.add_argument("--task", default="")
    learn_parser.add_argument("--session")
    learn_parser.add_argument("--summary", default="", help="Learning summary, or '-' to read from stdin")
    learn_parser.add_argument("--summary-file")
    learn_parser.add_argument("--skip", help="Record an explicit skip reason instead of ingesting learning")

    review_parser = sub.add_parser("review-change")
    review_parser.add_argument("--repo", required=True)
    review_parser.add_argument("--session")
    review_parser.add_argument("--strict", action="store_true")

    rules_parser = sub.add_parser("install-agent-rules")
    rules_parser.add_argument("--repo", required=True)
    rules_parser.add_argument("--agents", default="cursor", help="all, codex, cursor, claude, or comma-separated list")

    print_parser = sub.add_parser("print-config")
    print_parser.add_argument("--agent", required=True, choices=["codex", "cursor", "claude"])

    mcp_parser = sub.add_parser("mcp")
    mcp_parser.add_argument("name", choices=["vectordb", "github", "atlassian", "kapa", "zendesk"])

    zendesk_search_parser = sub.add_parser("zendesk-search")
    zendesk_search_parser.add_argument("--query", required=True)
    zendesk_search_parser.add_argument("--limit", type=int)

    zendesk_index_parser = sub.add_parser("zendesk-index")
    zendesk_index_group = zendesk_index_parser.add_mutually_exclusive_group(required=True)
    zendesk_index_group.add_argument("--query")
    zendesk_index_group.add_argument("--ticket-id")
    zendesk_index_parser.add_argument("--limit", type=int)

    return parser


def main() -> int:
    env = load_env()
    args = build_parser().parse_args()

    if args.command == "setup":
        setup(args, env)
    elif args.command == "start":
        start_stack(env)
    elif args.command == "stop":
        stop_stack(env)
    elif args.command == "doctor":
        doctor(env)
    elif args.command == "manifest":
        repo = Path(args.repo).expanduser().resolve()
        generate_manifest(repo, default_profile(repo, args.profile))
    elif args.command == "index":
        repo = Path(args.repo).expanduser().resolve()
        index_repo(repo, default_profile(repo, args.profile), env)
    elif args.command == "context":
        repo = Path(args.repo).expanduser().resolve()
        prepare_context(repo, read_stdin_if_requested(args.task), env, limit=args.limit)
    elif args.command == "learn":
        repo = Path(args.repo).expanduser().resolve()
        learn(
            repo,
            env,
            task=read_stdin_if_requested(args.task),
            session_id=args.session,
            summary=read_stdin_if_requested(args.summary),
            summary_file=args.summary_file,
            skip=args.skip,
        )
    elif args.command == "review-change":
        repo = Path(args.repo).expanduser().resolve()
        return review_change(repo, session_id=args.session, strict=args.strict)
    elif args.command == "install-agent-rules":
        repo = Path(args.repo).expanduser().resolve()
        install_agent_rules(repo, parse_agents(args.agents))
    elif args.command == "print-config":
        print_config(args.agent, env)
    elif args.command == "mcp":
        exec_mcp(args.name, env)
    elif args.command == "zendesk-search":
        require_zendesk_config(env)
        print(json.dumps(zendesk_search_tickets(env, args.query, args.limit), indent=2))
    elif args.command == "zendesk-index":
        require_zendesk_config(env)
        if args.ticket_id:
            print(json.dumps(zendesk_ingest_ticket(env, str(args.ticket_id)), indent=2))
        else:
            print(json.dumps(zendesk_index_query(env, args.query, args.limit), indent=2))
    else:
        raise AssertionError(args.command)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
