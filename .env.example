# Local PostgreSQL + pgvector
POSTGRES_DB=ai
POSTGRES_USER=ai
POSTGRES_PASSWORD=ai
POSTGRES_PORT=5432

# Local vectordb API
VDB_API_PORT=8000
VDB_API_URL=http://localhost:8000
VDB_DEBUG=false

# Keep this aligned with services/vectordb/db/init/001_schema.sql VECTOR dimension.
EMBEDDING_DIM=768

# Embedding backend used by vectordb.
#
# mock:
#   Deterministic local embeddings. No API key required. Good for plumbing tests
#   and first-time setup, but not semantically strong.
#
# ollama:
#   Local semantic embeddings from an Ollama daemon running on the host.
#   Set OLLAMA_URL and OLLAMA_MODEL below.
#
# openai-compatible:
#   Any HTTP embeddings provider implementing the OpenAI-compatible
#   POST /embeddings API shape. This includes OpenAI, and may include other
#   providers or internal gateways if they expose the same API contract.
#   Set EMBEDDING_BASE_URL, EMBEDDING_API_KEY, and EMBEDDING_MODEL below.
EMBEDDING_BACKEND=mock

# Used when EMBEDDING_BACKEND=ollama.
# From inside Docker, host.docker.internal points to the developer machine.
# Example model after `ollama pull nomic-embed-text`: nomic-embed-text
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=nomic-embed-text

# Used when EMBEDDING_BACKEND=openai-compatible.
# EMBEDDING_BASE_URL is the provider base URL without a trailing /embeddings.
# Examples:
#   OpenAI: https://api.openai.com/v1
#   Internal gateway: https://your-gateway.example.com/v1
EMBEDDING_BASE_URL=https://api.openai.com/v1
# Bearer token for the embeddings provider. Leave empty for mock/ollama.
EMBEDDING_API_KEY=
# Embedding model name understood by the selected provider.
# OpenAI example: text-embedding-3-small
EMBEDDING_MODEL=text-embedding-3-small
SEARCH_CANDIDATES=50

# GitHub MCP. Use a token with the minimum read permissions you need.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Atlassian remote MCP.
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v1/mcp
ATLASSIAN_SITE_URL=https://your-domain.atlassian.net/

# Kapa remote MCP. Set either KAPA_REMOTE_MCP_AUTH_HEADER or KAPA_API_TOKEN.
KAPA_REMOTE_MCP_URL=https://gravitee-internal.mcp.kapa.ai
KAPA_API_TOKEN=
KAPA_REMOTE_MCP_AUTH_HEADER=

# Zendesk Support integration. Disabled by default because not every team uses it.
#
# Set ZENDESK_ENABLED=true only for teams that should expose Zendesk read-only
# MCP tools and index Support tickets into vectordb during bootstrap.
ZENDESK_ENABLED=false

# Zendesk account base URL, with no /api/v2 suffix.
# Example: https://gravitee.zendesk.com
ZENDESK_BASE_URL=https://your-subdomain.zendesk.com

# Auth mode for Zendesk API calls:
# - oauth: use ZENDESK_OAUTH_ACCESS_TOKEN as a Bearer token.
# - api-token: use ZENDESK_EMAIL and ZENDESK_API_TOKEN.
ZENDESK_AUTH_MODE=oauth
ZENDESK_OAUTH_ACCESS_TOKEN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Maximum tickets fetched by one Zendesk search/index request.
ZENDESK_PAGE_SIZE=50
ZENDESK_TIMEOUT_SECONDS=15

# Query used by setup --bootstrap when ZENDESK_ENABLED=true.
# Keep it narrow enough for the team's first local index.
ZENDESK_INDEX_DEFAULT_QUERY=type:ticket updated>2026-01-01

# Grafana (read-only) integration. Disabled by default because not every team
# uses it. Set GRAFANA_ENABLED=true only for teams that should expose the
# read-only Grafana/Loki MCP tools (logs links, datasource queries, etc.).
GRAFANA_ENABLED=false

# Grafana instance base URL, with no trailing slash.
# Example: https://grafana.example.com
GRAFANA_BASE_URL=https://your-grafana-host

# Service account / API token with read access. Never commit a real token.
GRAFANA_TOKEN=

# UID of the Loki datasource holding your logs. Required when GRAFANA_ENABLED=true
# (there is no default - a uid that is correct for one Grafana org fails silently
# in every other one). Find it in Grafana under Connections > Data sources >
# (Loki): the uid is in the page URL and is NOT always the same as the display
# name shown in the list.
GRAFANA_LOGS_DATASOURCE_UID=

# Request timeout.
GRAFANA_TIMEOUT_SECONDS=15

# Optional config path overrides, useful for tests or non-standard installs.
CODEX_CONFIG=
CURSOR_MCP_CONFIG=
CLAUDE_MCP_CONFIG=
